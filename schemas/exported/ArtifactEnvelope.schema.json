{
  "$defs": {
    "AggregateType": {
      "enum": [
        "CASE",
        "APPEAL",
        "POLICY_EVOLUTION"
      ],
      "title": "AggregateType",
      "type": "string"
    },
    "AppealDecision": {
      "additionalProperties": false,
      "properties": {
        "appeal_decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Appeal Decision Id",
          "type": "string"
        },
        "conclusions": {
          "items": {
            "$ref": "#/$defs/FormalConclusion"
          },
          "minItems": 1,
          "title": "Conclusions",
          "type": "array"
        },
        "new_evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "New Evidence Ids",
          "type": "array"
        },
        "original_decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Original Decision Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "UPHOLD",
            "OVERTURN",
            "INSUFFICIENT_EVIDENCE"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "appeal_decision_id",
        "outcome",
        "conclusions",
        "original_decision_id",
        "new_evidence_ids"
      ],
      "title": "AppealDecision",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "EVIDENCE_BUNDLE",
        "RISK_ARGUMENT",
        "COUNTER_ARGUMENT",
        "DECISION_RECORD",
        "APPEAL_DECISION",
        "ATTRIBUTION_REPORT",
        "POLICY_PROPOSAL",
        "REPLAY_REPORT",
        "HUMAN_APPROVAL"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "AttributionReport": {
      "additionalProperties": false,
      "properties": {
        "appeal_decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Appeal Decision Id",
          "type": "string"
        },
        "attribution": {
          "enum": [
            "EVIDENCE_GAP",
            "AGENT_ERROR",
            "POLICY_GAP",
            "POLICY_CONFLICT"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "findings": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Findings",
          "type": "array"
        },
        "policy_change_recommended": {
          "title": "Policy Change Recommended",
          "type": "boolean"
        },
        "report_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "attribution",
        "findings",
        "appeal_decision_id",
        "policy_change_recommended"
      ],
      "title": "AttributionReport",
      "type": "object"
    },
    "CounterArgument": {
      "additionalProperties": false,
      "properties": {
        "alternative_explanations": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Alternative Explanations",
          "type": "array"
        },
        "argument_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Argument Id",
          "type": "string"
        },
        "conclusions": {
          "items": {
            "$ref": "#/$defs/FormalConclusion"
          },
          "minItems": 1,
          "title": "Conclusions",
          "type": "array"
        }
      },
      "required": [
        "argument_id",
        "conclusions",
        "alternative_explanations"
      ],
      "title": "CounterArgument",
      "type": "object"
    },
    "DecisionRecord": {
      "additionalProperties": false,
      "properties": {
        "conclusions": {
          "items": {
            "$ref": "#/$defs/FormalConclusion"
          },
          "minItems": 1,
          "title": "Conclusions",
          "type": "array"
        },
        "considered_argument_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "title": "Considered Argument Ids",
          "type": "array"
        },
        "decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "VIOLATION",
            "NO_VIOLATION",
            "INSUFFICIENT_EVIDENCE"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "outcome",
        "conclusions",
        "considered_argument_ids"
      ],
      "title": "DecisionRecord",
      "type": "object"
    },
    "EvidenceBundle": {
      "additionalProperties": false,
      "properties": {
        "agent_inferences": {
          "items": {
            "$ref": "#/$defs/InferenceRecord"
          },
          "title": "Agent Inferences",
          "type": "array"
        },
        "bundle_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Bundle Id",
          "type": "string"
        },
        "missing_information": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "observable_facts": {
          "items": {
            "$ref": "#/$defs/FactRecord"
          },
          "title": "Observable Facts",
          "type": "array"
        },
        "raw_evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Raw Evidence Refs",
          "type": "array"
        },
        "tool_failures": {
          "items": {
            "$ref": "#/$defs/ToolFailure"
          },
          "title": "Tool Failures",
          "type": "array"
        }
      },
      "required": [
        "bundle_id",
        "raw_evidence_refs",
        "observable_facts",
        "agent_inferences",
        "missing_information",
        "tool_failures"
      ],
      "title": "EvidenceBundle",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "CONTENT",
            "TRANSCRIPT",
            "ACCOUNT",
            "RELATIONSHIP",
            "APPEAL_SUBMISSION"
          ],
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_type",
        "source_ref",
        "content_hash",
        "collected_at"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FactRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "fact_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "fact_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Fact Key",
          "type": "string"
        },
        "record_type": {
          "const": "OBSERVED_FACT",
          "title": "Record Type",
          "type": "string"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "record_type",
        "fact_id",
        "fact_key",
        "value",
        "statement",
        "evidence_ids"
      ],
      "title": "FactRecord",
      "type": "object"
    },
    "FormalConclusion": {
      "additionalProperties": false,
      "properties": {
        "conclusion_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Conclusion Id",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "policy_ref": {
          "$ref": "#/$defs/PolicyReference"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "conclusion_id",
        "statement",
        "evidence_id",
        "policy_ref"
      ],
      "title": "FormalConclusion",
      "type": "object"
    },
    "HumanApproval": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "comment": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Comment",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision": {
          "enum": [
            "APPROVE",
            "REJECT",
            "REQUEST_CHANGES"
          ],
          "title": "Decision",
          "type": "string"
        },
        "proposal_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Proposal Artifact Id",
          "type": "string"
        },
        "replay_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Replay Id",
          "type": "string"
        },
        "reviewer_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "decision",
        "proposal_artifact_id",
        "replay_id",
        "reviewer_id",
        "comment",
        "created_at"
      ],
      "title": "HumanApproval",
      "type": "object"
    },
    "InferenceRecord": {
      "additionalProperties": false,
      "properties": {
        "basis_fact_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Basis Fact Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "inference_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Inference Id",
          "type": "string"
        },
        "record_type": {
          "const": "AGENT_INFERENCE",
          "title": "Record Type",
          "type": "string"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "record_type",
        "inference_id",
        "statement",
        "basis_fact_ids",
        "confidence"
      ],
      "title": "InferenceRecord",
      "type": "object"
    },
    "LockedPolicy": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "content_hash"
      ],
      "title": "LockedPolicy",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/PolicyApplicability"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "decision": {
          "enum": [
            "VIOLATION",
            "NO_VIOLATION"
          ],
          "title": "Decision",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "exceptions": {
          "$ref": "#/$defs/PolicyCondition"
        },
        "policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "required_elements": {
          "$ref": "#/$defs/PolicyCondition"
        },
        "status": {
          "enum": [
            "BASELINE",
            "CANDIDATE"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "status",
        "title",
        "description",
        "applicability",
        "required_elements",
        "exceptions",
        "decision",
        "content_hash"
      ],
      "title": "Policy",
      "type": "object"
    },
    "PolicyApplicability": {
      "additionalProperties": false,
      "properties": {
        "content_types": {
          "items": {
            "enum": [
              "VIDEO",
              "IMAGE",
              "TEXT",
              "AUDIO"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Content Types",
          "type": "array"
        }
      },
      "required": [
        "content_types"
      ],
      "title": "PolicyApplicability",
      "type": "object"
    },
    "PolicyChange": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "ADD",
            "REMOVE",
            "REPLACE"
          ],
          "title": "Operation",
          "type": "string"
        },
        "path": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "path",
        "operation",
        "rationale"
      ],
      "title": "PolicyChange",
      "type": "object"
    },
    "PolicyCondition": {
      "additionalProperties": false,
      "properties": {
        "all_of": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PolicyCondition"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "All Of"
        },
        "any_of": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PolicyCondition"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Any Of"
        },
        "condition_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Id"
        },
        "fact": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fact"
        },
        "op": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolicyOperator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "PolicyCondition",
      "type": "object"
    },
    "PolicyOperator": {
      "enum": [
        "EQ",
        "IN",
        "GTE",
        "LTE"
      ],
      "title": "PolicyOperator",
      "type": "string"
    },
    "PolicyProposal": {
      "additionalProperties": false,
      "properties": {
        "base_policy": {
          "$ref": "#/$defs/LockedPolicy"
        },
        "candidate_policy": {
          "$ref": "#/$defs/Policy"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/PolicyChange"
          },
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        },
        "proposal_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "proposal_revision": {
          "minimum": 1,
          "title": "Proposal Revision",
          "type": "integer"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "risks": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        }
      },
      "required": [
        "proposal_id",
        "proposal_revision",
        "base_policy",
        "candidate_policy",
        "changes",
        "reason",
        "risks"
      ],
      "title": "PolicyProposal",
      "type": "object"
    },
    "PolicyReference": {
      "additionalProperties": false,
      "properties": {
        "clause_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Clause Ids",
          "type": "array"
        },
        "policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "clause_ids"
      ],
      "title": "PolicyReference",
      "type": "object"
    },
    "ReplayMetrics": {
      "additionalProperties": false,
      "properties": {
        "baseline_false_negatives": {
          "minimum": 0,
          "title": "Baseline False Negatives",
          "type": "integer"
        },
        "baseline_false_positives": {
          "minimum": 0,
          "title": "Baseline False Positives",
          "type": "integer"
        },
        "candidate_false_negatives": {
          "minimum": 0,
          "title": "Candidate False Negatives",
          "type": "integer"
        },
        "candidate_false_positives": {
          "minimum": 0,
          "title": "Candidate False Positives",
          "type": "integer"
        },
        "changed_cases": {
          "minimum": 0,
          "title": "Changed Cases",
          "type": "integer"
        }
      },
      "required": [
        "baseline_false_positives",
        "candidate_false_positives",
        "baseline_false_negatives",
        "candidate_false_negatives",
        "changed_cases"
      ],
      "title": "ReplayMetrics",
      "type": "object"
    },
    "ReplayReport": {
      "additionalProperties": false,
      "properties": {
        "baseline_policy": {
          "$ref": "#/$defs/LockedPolicy"
        },
        "candidate_policy": {
          "$ref": "#/$defs/LockedPolicy"
        },
        "dataset_manifest_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Dataset Manifest Hash",
          "type": "string"
        },
        "dataset_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/ReplayMetrics"
        },
        "proposal_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "recommendation": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE"
          ],
          "title": "Recommendation",
          "type": "string"
        },
        "replay_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Replay Id",
          "type": "string"
        },
        "result_summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Result Summary",
          "type": "string"
        }
      },
      "required": [
        "replay_id",
        "proposal_id",
        "baseline_policy",
        "candidate_policy",
        "dataset_version",
        "dataset_manifest_hash",
        "metrics",
        "recommendation",
        "result_summary"
      ],
      "title": "ReplayReport",
      "type": "object"
    },
    "RiskArgument": {
      "additionalProperties": false,
      "properties": {
        "argument_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Argument Id",
          "type": "string"
        },
        "conclusions": {
          "items": {
            "$ref": "#/$defs/FormalConclusion"
          },
          "minItems": 1,
          "title": "Conclusions",
          "type": "array"
        },
        "uncertainties": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "argument_id",
        "conclusions",
        "uncertainties"
      ],
      "title": "RiskArgument",
      "type": "object"
    },
